{
  "name": "frontend-exploration-of-preact",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run check && node build.js",
    "check": "node node_modules/@biomejs/biome/bin/biome check .",
    "check:write": "node node_modules/@biomejs/biome/bin/biome check --write .",
    "dev": "npm run check && node build.js --watch --serve",
    "format": "node node_modules/@biomejs/biome/bin/biome format --write .",
    "format:check": "node node_modules/@biomejs/biome/bin/biome format .",
    "lint": "node node_modules/@biomejs/biome/bin/biome lint .",
    "bench:notes-pdf": "node benchmarks/notes-pdf.mjs",
    "bench:notes-search": "node benchmarks/notes-search.mjs",
    "serve": "node build.js --serve",
    "test": "node --test src/*.test.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "fast-fuzzy": "^1.12.0",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@stylexjs/unplugin": "^0.19.0",
    "esbuild": "^0.25.9",
    "fuse.js": "^7.5.0",
    "fuzzysort": "^4.0.2",
    "html-to-pdfmake": "^2.5.34",
    "jsdom": "^30.0.1",
    "pdfmake": "^0.3.11"
  }
}
